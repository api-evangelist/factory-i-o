{
  "opencollection": "1.0.0",
  "info": {
    "name": "FACTORY I/O Web Tag Values Tags API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:7410/api/tags",
            "params": [
              {
                "name": "name",
                "value": "*reset*",
                "type": "query",
                "description": "Case-insensitive filter on the tag's name. Supports * and ? wildcard characters."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by data type of the tag's value."
              },
              {
                "name": "kind",
                "value": "",
                "type": "query",
                "description": "Filter by kind of tag from the controller point of view."
              }
            ]
          },
          "docs": "Returns a list of all tags in the scene, with optional filters."
        },
        {
          "info": {
            "name": "Get tag by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:7410/api/tags/:id",
            "params": [
              {
                "name": "id",
                "value": "b61dc29b-650d-4145-be65-4fea9cffc802",
                "type": "path",
                "description": "Unique identifier for the tag."
              }
            ]
          },
          "docs": "Returns a single tag identified by its unique id."
        },
        {
          "info": {
            "name": "Get tags by name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:7410/api/tags/by-name/:name",
            "params": [
              {
                "name": "name",
                "value": "FACTORY I%2FO (Reset)",
                "type": "path",
                "description": "Name of the tag(s) to find."
              }
            ]
          },
          "docs": "Returns tags whose name matches the given name. May return more than one tag as tag names are not unique in Factory I/O."
        }
      ]
    }
  ],
  "bundled": true
}